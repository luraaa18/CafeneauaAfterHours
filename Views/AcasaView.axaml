<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CafeneauaAfterHours.ViewModels"
             x:Class="CafeneauaAfterHours.Views.AcasaView"
             x:DataType="vm:AcasaViewModel">

  <StackPanel Spacing="20">

    <Grid ColumnDefinitions="1.2*,*" Margin="0,25">
      <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center" Margin="0,0,12,0">
        <Border Classes="tag">
          <TextBlock Text="deschis zilnic 8:00 - 22:00" FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}"/>
        </Border>
        <TextBlock Classes="h1" Text="Cafea bună, loc liniștit și rezervare rapidă"
                   TextWrapping="Wrap"/>
        <TextBlock Classes="lead" TextWrapping="Wrap"
                   Text="After Hours este o cafenea modernă și relaxantă, creată pentru oamenii care vor să se bucure de cafea bună, deserturi de casă și o atmosferă liniștită. Localul oferă băuturi pe bază de cafea, ceaiuri și gustări dulci, într-un spațiu confortabil potrivit atât pentru întâlniri cu prietenii, cât și pentru studiu sau lucru."/>
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,15,0,0">
          <Button Classes="main" Content="Rezervă o masă"
                  Command="{Binding NavigheazaLaCommand}"
                  CommandParameter="rezervare"/>
          <Button Classes="normal" Content="Vezi meniul"
                  Command="{Binding NavigheazaLaCommand}"
                  CommandParameter="meniu"/>
        </StackPanel>
      </StackPanel>

      <Border Grid.Column="1" Classes="card" VerticalAlignment="Center" Margin="13,0,0,0">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <TextBlock Text="☕" FontSize="80" HorizontalAlignment="Center"/>
          <TextBlock Classes="h2" Text="Ce găsești aici" HorizontalAlignment="Center"/>
          <StackPanel Spacing="6">
            <TextBlock Text="✓ cafea bună și deserturi de casă"/>
            <TextBlock Text="✓ muzică relaxantă"/>
            <TextBlock Text="✓ spațiu confortabil"/>
            <TextBlock Text="✓ atmosferă prietenoasă"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Classes="h2" Text="Pe scurt"/>
    <Grid ColumnDefinitions="*,*,*">
      <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
        <StackPanel Spacing="8">
          <TextBlock Text="☕" FontSize="32"/>
          <TextBlock Classes="h3" Text="Cafea"/>
          <TextBlock TextWrapping="Wrap" Text="Espresso, cappuccino și latte pentru orice moment al zilei."/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Margin="8,0">
        <StackPanel Spacing="8">
          <TextBlock Text="🍰" FontSize="32"/>
          <TextBlock Classes="h3" Text="Deserturi"/>
          <TextBlock TextWrapping="Wrap" Text="Prăjituri și croissante făcute în casă."/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Margin="8,0,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="📱" FontSize="32"/>
          <TextBlock Classes="h3" Text="Contact"/>
          <TextBlock TextWrapping="Wrap" Text="Rezervări rapide și răspunsuri ușor de obținut."/>
        </StackPanel>
      </Border>
    </Grid>

  </StackPanel>
</UserControl>
