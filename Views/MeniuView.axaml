<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CafeneauaAfterHours.ViewModels"
             xmlns:models="using:CafeneauaAfterHours.Models"
             x:Class="CafeneauaAfterHours.Views.MeniuView"
             x:DataType="vm:MeniuViewModel">

  <StackPanel Spacing="15">
    <TextBlock Classes="h1" Text="Meniu"/>
    <TextBlock Classes="lead" TextWrapping="Wrap"
               Text="Descoperă băuturile și deserturile disponibile în cafeneaua After Hours."/>

    <Button Classes="normal" Content="Resetează comenzile"
            Command="{Binding ReseteazaComenziCommand}" HorizontalAlignment="Left"/>

    <TextBlock Classes="h2" Text="Cafele"/>
    <ItemsControl ItemsSource="{Binding Cafele}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="models:MeniuItem">
          <Border Classes="menuitem" Classes.popular="{Binding EstePopular}" Margin="7">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
              <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                <TextBlock Classes="h3" Text="{Binding Nume}"/>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Descriere}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10">
                <Run Text="{Binding Pret}"/><Run Text=" lei"/>
              </TextBlock>
              <Button Grid.Column="0" Grid.Row="1" Classes="main" Content="Comandă"
                      HorizontalAlignment="Left"
                      Command="{Binding $parent[UserControl].((vm:MeniuViewModel)DataContext).ComandaCommand}"
                      CommandParameter="{Binding}"/>
              <TextBlock Grid.Column="1" Grid.Row="1" Classes="muted" VerticalAlignment="Center"
                         Text="{Binding TextComenzi}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="h2" Text="Deserturi"/>
    <ItemsControl ItemsSource="{Binding Deserturi}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="models:MeniuItem">
          <Border Classes="menuitem" Classes.popular="{Binding EstePopular}" Margin="7">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                <TextBlock Classes="h3" Text="{Binding Nume}"/>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Descriere}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10">
                <Run Text="{Binding Pret}"/><Run Text=" lei"/>
              </TextBlock>
              <Button Grid.Column="0" Grid.Row="1" Classes="main" Content="Comandă"
                      HorizontalAlignment="Left"
                      Command="{Binding $parent[UserControl].((vm:MeniuViewModel)DataContext).ComandaCommand}"
                      CommandParameter="{Binding}"/>
              <TextBlock Grid.Column="1" Grid.Row="1" Classes="muted" VerticalAlignment="Center"
                         Text="{Binding TextComenzi}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </StackPanel>
</UserControl>
