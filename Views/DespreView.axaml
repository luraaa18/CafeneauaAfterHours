<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CafeneauaAfterHours.ViewModels"
             x:Class="CafeneauaAfterHours.Views.DespreView"
             x:DataType="vm:DespreViewModel">

  <StackPanel Spacing="20">
    <TextBlock Classes="h1" Text="Despre noi"/>
    <TextBlock Classes="lead" TextWrapping="Wrap"
               Text="After Hours este un loc relaxant unde oamenii pot savura cafea, deserturi și timp petrecut cu prietenii într-o atmosferă liniștită."/>

    <Grid ColumnDefinitions="*,*,*">
      <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
        <StackPanel Spacing="8">
          <TextBlock Text="⭐" FontSize="32"/>
          <TextBlock Classes="h3" Text="4.9/5"/>
          <TextBlock TextWrapping="Wrap" Text="Clienții apreciază atmosfera și cafeaua noastră."/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Margin="8,0">
        <StackPanel Spacing="8">
          <TextBlock Text="📍" FontSize="32"/>
          <TextBlock Classes="h3" Text="Adresă"/>
          <TextBlock TextWrapping="Wrap" Text="Str. Teilor 14, Timișoara."/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Margin="8,0,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="🕒" FontSize="32"/>
          <TextBlock Classes="h3" Text="Program"/>
          <TextBlock TextWrapping="Wrap" Text="Deschis zilnic între 08:00 și 22:00."/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Atmosfera noastră" Margin="0"/>
        <TextBlock TextWrapping="Wrap"
                   Text="Am creat un spațiu simplu și confortabil, potrivit pentru relaxare, studiu sau întâlniri."/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
